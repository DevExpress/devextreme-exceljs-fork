{
  "name": "devextreme-exceljs-fork",
  "version": "5.0.0",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "description": "Fork of Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": "Developer Express Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevExpress/devextreme-exceljs-fork.git"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "main": "./dx-excel-fork.js",
  "browser": "./dist/dx-exceljs-fork.min.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "lib",
    "dx-excel-fork.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.d.ts"
  ],
  "scripts": {
    "test": "pnpm run test:full",
    "test:full": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:end-to-end && pnpm run test:browser && pnpm run test:dist",
    "test:version": "pnpm run test:full",
    "test:unit": "mocha --require spec/config/setup --require spec/config/setup-unit spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup spec/end-to-end --recursive",
    "test:browser": "pnpm exec playwright test",
    "test:dist": "mocha --require spec/config/setup spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "mocha -r ts-node/register spec/typescript/**/*.spec.ts",
    "type-check": "tsc index.d.ts",
    "clean-build": "pnpm run clean && pnpm run build",
    "lint": "eslint --format node_modules/eslint-friendly-formatter/index.js .",
    "lint:fix": "eslint --format node_modules/eslint-friendly-formatter/index.js --fix .",
    "lint:staged": "lint-staged",
    "clean": "rm -rf dist",
    "build": "node tools/build/build.js",
    "prepare-and-install": "pnpm install --frozen-lockfile && pnpm run build",
    "preversion": "pnpm run clean && pnpm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "eslint --format node_modules/eslint-friendly-formatter/index.js"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.5",
    "jszip": "^3.10.1",
    "readable-stream": "^3.6.0",
    "saxes": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.12.4",
    "buffer": "^5.7.1",
    "chai": "^4.3.7",
    "chai-datetime": "^1.8.1",
    "chai-xml": "^0.4.1",
    "dirty-chai": "^2.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.0.0",
    "events": "^3.3.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^11.7.1",
    "process": "^0.11.10",
    "sax": "^1.2.4",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "timers-browserify": "^1.4.2",
    "ts-node": "^8.10.2",
    "typescript": "^5.9.3"
  }
}
